/* ===================== WIZARD: RANGE HELPERS ===================== */
function dateRange(fromStr, toStr){
  const out=[];
  let d = new Date(fromStr+'T00:00:00');
  const end = new Date((toStr||fromStr)+'T00:00:00');
  while(d<=end){
    out.push(d.toISOString().slice(0,10));
    d.setDate(d.getDate()+1);
  }
  return out;
}
function dsInCurrentMonth(ds){
  const {y,m} = parseMonthKey(currentMonthKey);
  const d = new Date(ds+'T00:00:00');
  return d.getFullYear()===y && d.getMonth()===m;
}

function addLockEntries(kind, staffId, from, to){
  if(!staffId || !from){ toast('กรุณาเลือกเจ้าหน้าที่และวันที่'); return false; }
  const md = ensureMonth(currentMonthKey);
  const dates = dateRange(from, to||from).filter(dsInCurrentMonth);
  if(dates.length===0){ toast('วันที่ที่เลือกไม่อยู่ในเดือนที่กำลังดู'); return false; }
  dates.forEach(ds=> setStatus(md, staffId, ds, kind));
  return true;
}

function listLockEntries(kind){
  const md = ensureMonth(currentMonthKey);
  const items = []; // {staffId, dates:[]}
  const byStaff = {};
  Object.keys(md.status).forEach(sid=>{
    Object.keys(md.status[sid]).forEach(ds=>{
      if(md.status[sid][ds]===kind){
        (byStaff[sid]=byStaff[sid]||[]).push(ds);
      }
    });
  });
  Object.keys(byStaff).forEach(sid=>{
    const dates = byStaff[sid].sort();
    items.push({staffId:sid, dates});
  });
  return items;
}
async function removeLockEntry(kind, staffId, ds){
  const md = ensureMonth(currentMonthKey);
  setStatus(md, staffId, ds, null);
  await saveAll(false);
  renderWizard();
}

function renderLockList(kind, ulId){
  const ul = document.getElementById(ulId);
  const items = listLockEntries(kind);
  if(items.length===0){ ul.innerHTML = '<li class="muted" style="background:none;">ยังไม่มีข้อมูล</li>'; return; }
  ul.innerHTML = items.map(it=>{
    const s = staffById(it.staffId);
    const label = it.dates.map(ds=>ds.slice(8,10)).join(', ');
    return `<li><span>${s?s.name:'?'} — วันที่ ${label}</span>
      <span>${it.dates.map(ds=>`<button onclick="removeLockEntry('${kind}','${it.staffId}','${ds}')">ลบ ${ds.slice(8,10)}</button>`).join(' ')}</span>
    </li>`;
  }).join('');
}

