/* ===================== STORAGE ===================== */
// Uses Claude's window.storage when available (inside claude.ai artifacts).
// Falls back to browser localStorage automatically when hosted elsewhere,
// e.g. on GitHub Pages, so the app keeps working outside Claude.
const LS_PREFIX = 'or-morning-assignment:';
const hasClaudeStorage = (typeof window !== 'undefined') && !!window.storage;

async function storageGet(key, fallback){
  if(hasClaudeStorage){
    try{
      const r = await window.storage.get(key,false);
      return r ? JSON.parse(r.value) : fallback;
    }catch(e){ return fallback; }
  }
  try{
    const raw = localStorage.getItem(LS_PREFIX+key);
    return raw!==null ? JSON.parse(raw) : fallback;
  }catch(e){ return fallback; }
}
async function storageSet(key, value){
  if(hasClaudeStorage){
    try{ await window.storage.set(key, JSON.stringify(value), false); }
    catch(e){ console.error('storage set failed', key, e); }
    return;
  }
  try{ localStorage.setItem(LS_PREFIX+key, JSON.stringify(value)); }
  catch(e){ console.error('localStorage set failed', key, e); }
}

/* ---- Manual backup: export / import full state as a .json file ----
   This is the real backup for GitHub-Pages hosting, since localStorage
   only lives inside one browser on one device. */
function exportBackup(){
  const payload = { staff: STATE.staff, pairs: STATE.pairs, months: STATE.months, exportedAt: new Date().toISOString() };
  const blob = new Blob([JSON.stringify(payload, null, 2)], {type:'application/json'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  const {y,m} = currentMonthKey ? parseMonthKey(currentMonthKey) : {y:new Date().getFullYear(), m:new Date().getMonth()};
  a.href = url;
  a.download = `or-morning-assignment-backup-${y}-${pad2(m+1)}.json`;
  document.body.appendChild(a); a.click(); a.remove();
  URL.revokeObjectURL(url);
}
async function importBackupFile(file){
  const text = await file.text();
  let data;
  try{ data = JSON.parse(text); }catch(e){ toast('ไฟล์ไม่ถูกต้อง อ่านไม่ได้'); return; }
  if(!data || !Array.isArray(data.staff)){ toast('ไฟล์นี้ไม่ใช่ไฟล์แบ็คอัพของแอปนี้'); return; }
  if(!confirm('นำเข้าข้อมูลนี้จะเขียนทับข้อมูลปัจจุบันทั้งหมด ต้องการดำเนินการต่อหรือไม่?')) return;
  STATE.staff = data.staff || [];
  STATE.pairs = data.pairs || [];
  STATE.months = data.months || {};
  await saveAll(false);
  currentMonthKey = null;
  populateMonthSelect();
  renderAll();
  toast('นำเข้าข้อมูลสำเร็จ');
}

async function saveAll(showToast){
  await storageSet(STORE_KEYS.STAFF, STATE.staff);
  await storageSet(STORE_KEYS.PAIRS, STATE.pairs);
  await storageSet(STORE_KEYS.MONTHS, Object.keys(STATE.months));
  for(const mk of Object.keys(STATE.months)){
    await storageSet('month:'+mk, STATE.months[mk]);
  }
  if(showToast) toast('บันทึกข้อมูลแล้ว');
}

async function loadAll(){
  STATE.staff = await storageGet(STORE_KEYS.STAFF, null);
  STATE.pairs = await storageGet(STORE_KEYS.PAIRS, []);
  const monthKeys = await storageGet(STORE_KEYS.MONTHS, []);
  STATE.months = {};
  for(const mk of monthKeys){
    STATE.months[mk] = await storageGet('month:'+mk, null);
  }
  if(!STATE.staff){
    await buildDemoData();
  }
}

/* ===================== UTIL ===================== */
function uid(prefix){ return prefix+'_'+Math.random().toString(36).slice(2,9); }
function toast(msg){
  const t=document.getElementById('toast');
  t.textContent=msg; t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'),1800);
}
function pad2(n){ return String(n).padStart(2,'0'); }
function dstr(y,m,d){ return `${y}-${pad2(m+1)}-${pad2(d)}`; } // m is 0-based
function monthKeyOf(y,m){ return `${y}-${pad2(m+1)}`; }
function parseMonthKey(mk){ const [y,m]=mk.split('-').map(Number); return {y, m:m-1}; }
function daysInMonth(y,m){ return new Date(y,m+1,0).getDate(); }
function isWeekend(y,m,d){ const wd=new Date(y,m,d).getDay(); return wd===0||wd===6; }
function workingDays(y,m){
  const n=daysInMonth(y,m); const out=[];
  for(let d=1; d<=n; d++){ if(!isWeekend(y,m,d)) out.push(d); }
  return out;
}
function beYear(y){ return y+543; }
function thaiMonthName(m){
  return ['มกราคม','กุมภาพันธ์','มีนาคม','เมษายน','พฤษภาคม','มิถุนายน','กรกฎาคม','สิงหาคม','กันยายน','ตุลาคม','พฤศจิกายน','ธันวาคม'][m];
}
function yearsExperience(startDate){
  const s=new Date(startDate); const now=new Date();
  let years = now.getFullYear()-s.getFullYear();
  const m = now.getMonth()-s.getMonth();
  if(m<0 || (m===0 && now.getDate()<s.getDate())) years--;
  return Math.max(0,years);
}
function experienceGroup(years){
  if(years>=10) return 'Senior';
  if(years>=5) return 'Experienced';
  if(years>=2) return 'Intermediate';
  return 'Junior';
}
function staffById(id){ return STATE.staff.find(s=>s.id===id); }
function activeStaff(){ return STATE.staff.filter(s=>s.active); }

function ensureMonth(mk){
  if(!STATE.months[mk]){
    STATE.months[mk] = {
      incharge: {R1:null, Open:null, RR:null},
      status: {},   // status[staffId][dateStr] = 'vac'|'X'|'อบรม'|'OD'
      assign: {},   // assign[staffId][dateStr] = {area:'R1'|'Open'|'RR', acting:bool}
      workflow: { vacationConfirmed:false, offConfirmed:false, trainingConfirmed:false, scheduleConfirmed:false },
      actingLog: {},
      conflicts: []
    };
  }
  return STATE.months[mk];
}
function getStatus(md, staffId, ds){ return md.status[staffId] ? md.status[staffId][ds] : undefined; }
function setStatus(md, staffId, ds, val){
  if(!md.status[staffId]) md.status[staffId]={};
  if(val===null){ delete md.status[staffId][ds]; } else { md.status[staffId][ds]=val; }
}
function getAssign(md, staffId, ds){ return md.assign[staffId] ? md.assign[staffId][ds] : undefined; }
function setAssign(md, staffId, ds, area, acting){
  if(!md.assign[staffId]) md.assign[staffId]={};
  if(area===null){ delete md.assign[staffId][ds]; } else { md.assign[staffId][ds] = {area, acting: !!acting}; }
}

/* ===================== DEMO DATA ===================== */
async function buildDemoData(){
  const today = new Date();
  const names = [
    ['RN A','RN'],['RN B','RN'],['RN C','RN'],['RN D','RN'],['RN E','RN'],
    ['RN F','RN'],['RN G','RN'],['RN H','RN'],['RN I','RN'],['RN J','RN'],
    ['PN A','PN'],['PN B','PN'],['PN C','PN']
  ];
  const startOffsets = [12,10,8,6,5,4,3,2,1.5,0.7,7,3,1]; // years ago approx
  STATE.staff = names.map(([name,type],i)=>{
    const yearsAgo = startOffsets[i];
    const start = new Date(today.getFullYear()-Math.floor(yearsAgo), today.getMonth()-Math.round((yearsAgo%1)*12), today.getDate());
    return {
      id: uid('st'), name, type, active:true,
      startDate: start.toISOString().slice(0,10),
      comp: { R1:true, Open:true, RR: type==='RN' },
      inch: { R1:false, Open:false, RR:false }
    };
  });
  // customize competencies per spec: not everyone can do everything, some R1 but not incharge
  const byName = n => STATE.staff.find(s=>s.name===n);
  byName('RN A').inch = {R1:true, Open:false, RR:false};
  byName('RN B').inch = {R1:false, Open:true, RR:false};
  byName('RN C').inch = {R1:false, Open:false, RR:true};
  byName('RN D').inch = {R1:true, Open:false, RR:false}; // ห้อง4, can act as R1 incharge
  byName('RN D').comp = {R1:true, Open:true, RR:false};
  byName('RN E').inch = {R1:false, Open:false, RR:false};
  byName('RN E').comp = {R1:true, Open:true, RR:false};
  byName('RN F').comp = {R1:false, Open:false, RR:true};
  byName('RN F').inch = {R1:true, Open:false, RR:true}; // RR nurse who could act R1 incharge but should be last resort
  byName('RN G').comp = {R1:true, Open:true, RR:false};
  byName('RN G').inch = {R1:false, Open:false, RR:false};
  byName('RN H').comp = {R1:true, Open:true, RR:true};
  byName('RN H').inch = {R1:false, Open:true, RR:false};
  byName('RN I').comp = {R1:true, Open:true, RR:false};
  byName('RN I').inch = {R1:false, Open:false, RR:false};
  byName('RN J').comp = {R1:false, Open:true, RR:true};
  byName('RN J').inch = {R1:false, Open:false, RR:true};
  ['PN A','PN B','PN C'].forEach(n=>{ const s=byName(n); s.comp={R1:true,Open:true,RR:false}; s.inch={R1:false,Open:false,RR:false}; });

  STATE.pairs = [
    { a: byName('RN E').id, b: byName('RN G').id },
    { a: byName('PN A').id, b: byName('PN B').id }
  ];

  const y = today.getFullYear(), m = today.getMonth();
  const mk = monthKeyOf(y,m);
  const md = ensureMonth(mk);
  md.incharge = { R1: byName('RN A').id, Open: byName('RN B').id, RR: byName('RN C').id };

  // Demo: RN A (R1 incharge) is X on the 3rd working day -> acting incharge should come from ห้อง4 (RN D)
  const wds = workingDays(y,m);
  if(wds.length>2){
    setStatus(md, byName('RN A').id, dstr(y,m,wds[2]), 'X');
  }
  // Demo: vacation example
  if(wds.length>5){
    setStatus(md, byName('RN E').id, dstr(y,m,wds[3]), 'vac');
    setStatus(md, byName('RN E').id, dstr(y,m,wds[4]), 'vac');
    setStatus(md, byName('RN E').id, dstr(y,m,wds[5]), 'vac');
  }
  // Demo training
  if(wds.length>1) setStatus(md, byName('RN I').id, dstr(y,m,wds[1]), 'อบรม');
  // Demo OD
  if(wds.length>4) setStatus(md, byName('PN C').id, dstr(y,m,wds[4]), 'OD');
  // Demo: no ห้อง4 acting available for Open incharge on a later day (RN B off, and make RN H/others unavailable that day is complex; instead just leave as scenario handled live)
  if(wds.length>7){
    setStatus(md, byName('RN B').id, dstr(y,m,wds[7]), 'X');
    setStatus(md, byName('RN H').id, dstr(y,m,wds[7]), 'X'); // remove the other ห้อง4 open-incharge-capable person too
  }

  await saveAll(false);
}

