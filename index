  document.querySelector('nav.tabs button[data-tab="dashboard"]').click();
  setTimeout(()=>window.print(), 100);
});

/* ===================== INIT ===================== */
function renderAll(){
  populateMonthSelect();
  renderDashboard();
  renderStaffTab();
  renderPairsTab();
  renderWizard();
  renderConflicts();
  renderReport();
}

(async function init(){
  const note = document.getElementById('storageNote');
  note.textContent = hasClaudeStorage
    ? 'บันทึกข้อมูลผ่าน Claude storage (ใช้ได้เฉพาะในแชทนี้/บัญชีนี้)'
    : 'บันทึกข้อมูลไว้ในเบราว์เซอร์นี้เท่านั้น (localStorage) — กด "ดาวน์โหลดแบ็คอัพ" เป็นระยะเพื่อกันข้อมูลหาย และใช้ "นำเข้าแบ็คอัพ" เมื่อเปลี่ยนเครื่อง/เบราว์เซอร์';
  await loadAll();
  populateMonthSelect();
  renderAll();
})();
</script>
