/* ===================== WIZARD RENDER ===================== */
function renderWizard(){
  fillStaffSelects();
  const md = ensureMonth(currentMonthKey);
  const wf = md.workflow;
  const steps = [
    {n:1, label:'🌴 Vacation', done: wf.vacationConfirmed, locked:false},
