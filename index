  if(st==='vac') return {cls:'cell-vac', text:'vac'};
  if(st==='X') return {cls:'cell-X', text:'X'};
  if(st==='อบรม') return {cls:'cell-train', text:'อบรม'};
  if(st==='OD') return {cls:'cell-od', text:'OD'};
