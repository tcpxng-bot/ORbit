function closeModal(){ document.getElementById('modalRoot').innerHTML=''; }
async function applyCellEdit(staffId, ds, val){
  const s = staffById(staffId);
  const md = ensureMonth(currentMonthKey);
  if(val==='RR' && s.type==='PN'){
    document.getElementById('cellEditMsg').textContent = 'ไม่สามารถจัด PN เข้า RR ได้';
    return;
  }
  // pair check for area assignment
  if(['R1','Open','RR'].includes(val)){
    const usedToday = new Set(STATE.staff.filter(x=>{const a=getAssign(md,x.id,ds); return a && x.id!==staffId;}).map(x=>x.id));
    if(pairConflictExists(md, ds, val, staffId, usedToday)){
      document.getElementById('cellEditMsg').textContent = 'มีข้อจำกัดคู่: บุคคลนี้ถูกกำหนดไม่ให้อยู่ Area เดียวกันกับคู่ที่จำกัดไว้ในวันนี้';
      return;
    }
  }
  if(LOCK_TYPES.includes(val)){
    setStatus(md, staffId, ds, val);
    setAssign(md, staffId, ds, null);
  } else if(val==='—'){
    setStatus(md, staffId, ds, null);
    setAssign(md, staffId, ds, null);
  } else {
    setStatus(md, staffId, ds, null);
    setAssign(md, staffId, ds, val, false);
  }
  await saveAll(false);
  closeModal();
  renderDashboard();
  toast('อัปเดตแล้ว');
}

