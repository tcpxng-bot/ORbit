function renderReport(){
  const md = ensureMonth(currentMonthKey);
  const {y,m} = parseMonthKey(currentMonthKey);
  const wds = workingDays(y,m);
  const rows = activeStaff().map(s=>{
    let R1=0,Open=0,RR=0,X=0,vac=0,train=0,acting=0;
    wds.forEach(d=>{
      const ds = dstr(y,m,d);
      const st = getStatus(md,s.id,ds);
      if(st==='X') X++;
      if(st==='vac') vac++;
      if(st==='อบรม') train++;
      const a = getAssign(md,s.id,ds);
      if(a){
        if(a.area==='R1') R1++;
        if(a.area==='Open') Open++;
        if(a.area==='RR') RR++;
        if(a.acting) acting++;
      }
    });
    const total = R1+Open+RR;
    const isFixed = AREAS.some(ar=>md.incharge[ar]===s.id);
    return {s, R1, Open, RR, X, vac, train, acting, total, isFixed};
  });
  const rotating = rows.filter(r=>!r.isFixed);
  const avg = rotating.length ? rotating.reduce((a,r)=>a+r.total,0)/rotating.length : 0;
  const tbody = document.querySelector('#reportTable tbody');
  tbody.innerHTML = rows.map(r=>{
    const diff = r.isFixed ? '<span class="muted">Fixed Incharge</span>' : (r.total-avg).toFixed(1);
    return `<tr>
      <td>${r.s.name}${r.isFixed?' 👑':''}</td>
      <td>${r.s.type}</td>
      <td>${r.R1}</td><td>${r.Open}</td><td>${r.RR}</td>
      <td>${r.X}</td><td>${r.vac}</td><td>${r.train}</td>
      <td>${r.acting}</td><td>${r.total}</td><td>${diff}</td>
    </tr>`;
  }).join('');
}

