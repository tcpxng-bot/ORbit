/* ===================== MONTH SELECT ===================== */
function populateMonthSelect(){
  const sel = document.getElementById('monthSelect');
  const today = new Date();
  const keys = new Set(Object.keys(STATE.months));
  // ensure current + next 2 months exist as options
  for(let i=-1;i<=2;i++){
    const d = new Date(today.getFullYear(), today.getMonth()+i, 1);
    keys.add(monthKeyOf(d.getFullYear(), d.getMonth()));
  }
  const sorted = Array.from(keys).sort();
  sel.innerHTML = sorted.map(mk=>{
    const {y,m} = parseMonthKey(mk);
    return `<option value="${mk}">${thaiMonthName(m)} ${beYear(y)}</option>`;
  }).join('');
  if(!currentMonthKey || !sorted.includes(currentMonthKey)){
    currentMonthKey = monthKeyOf(today.getFullYear(), today.getMonth());
  }
  sel.value = currentMonthKey;
  ensureMonth(currentMonthKey);
}
document.getElementById('monthSelect').addEventListener('change', (e)=>{
  currentMonthKey = e.target.value;
  ensureMonth(currentMonthKey);
  renderAll();
});

