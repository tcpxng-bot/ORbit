<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>OR Morning Assignment</title>
<style>
  :root{
    --ink:#1f2a2e;
    --ink-soft:#5b6b6f;
    --paper:#faf9f6;
    --line:#dfe3e0;
    --r1:#d8e6f5;
    --r1-ink:#2b5a86;
    --open:#fffefb;
    --open-line:#ece6d8;
    --rr:#d9efdd;
    --rr-ink:#2f7a45;
    --x:#e3e5e4;
    --x-ink:#5b6165;
    --vac:#f6dbe4;
    --vac-ink:#9c3f63;
    --train:#faedc0;
    --train-ink:#8a6d10;
    --od:#e6e0f2;
    --od-ink:#5f4a8c;
    --danger:#c1443a;
    --danger-bg:#fbe6e2;
    --warn:#b8722a;
    --warn-bg:#fbecd9;
    --good:#2f7a45;
    --good-bg:#e2f2e6;
    --accent:#2b5a86;
    --radius:8px;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Sarabun,"Noto Sans Thai",Roboto,sans-serif;
    background:var(--paper);
    color:var(--ink);
    font-size:14px;
    line-height:1.4;
  }
  header.app-header{
    position:sticky; top:0; z-index:50;
    background:#fff; border-bottom:1px solid var(--line);
    padding:10px 16px;
    display:flex; align-items:center; gap:14px; flex-wrap:wrap;
  }
  header.app-header h1{
    font-size:16px; margin:0; font-weight:700; letter-spacing:.2px;
    display:flex; align-items:center; gap:8px;
  }
  header.app-header h1 .dot{width:9px;height:9px;border-radius:50%;background:var(--accent);display:inline-block;}
  .month-picker{display:flex; align-items:center; gap:6px; font-size:13px;}
  .month-picker select{padding:5px 8px; border-radius:6px; border:1px solid var(--line); background:#fff;}
  .header-actions{margin-left:auto; display:flex; gap:8px; flex-wrap:wrap;}
  button{
    font-family:inherit; font-size:13px; cursor:pointer;
    border:1px solid var(--line); background:#fff; color:var(--ink);
    padding:7px 12px; border-radius:7px; transition:background .12s,border-color .12s;
  }
  button:hover{background:#f2f1ec;}
  button.primary{background:var(--accent); border-color:var(--accent); color:#fff; font-weight:600;}
  button.primary:hover{background:#234a70;}
  button.ghost{background:transparent; border-color:transparent; color:var(--ink-soft);}
  button:disabled{opacity:.4; cursor:not-allowed;}
  button.danger{color:var(--danger); border-color:var(--danger-bg);}

  nav.tabs{
    display:flex; gap:2px; padding:0 16px; background:#fff; border-bottom:1px solid var(--line);
    overflow-x:auto;
  }
  nav.tabs button{
    border:none; border-bottom:2px solid transparent; border-radius:0; background:transparent;
    padding:10px 12px; font-weight:600; color:var(--ink-soft); white-space:nowrap;
  }
  nav.tabs button.active{color:var(--accent); border-bottom-color:var(--accent);}

  main{padding:16px; max-width:1500px; margin:0 auto;}
  .panel{display:none;}
  .panel.active{display:block;}

  .card{background:#fff; border:1px solid var(--line); border-radius:var(--radius); padding:14px; margin-bottom:14px;}
  .card h2{font-size:14px; margin:0 0 10px; font-weight:700;}
  .card h3{font-size:13px; margin:14px 0 8px; font-weight:700; color:var(--ink-soft);}
  .muted{color:var(--ink-soft); font-size:12.5px;}
  .row{display:flex; gap:10px; flex-wrap:wrap; align-items:center;}
  .field{display:flex; flex-direction:column; gap:4px; font-size:12.5px;}
  .field label{color:var(--ink-soft); font-weight:600;}
  input,select{
    font-family:inherit; font-size:13px; padding:6px 8px; border:1px solid var(--line); border-radius:6px; background:#fff;
  }
  table{border-collapse:collapse; width:100%; font-size:12.5px;}
  th,td{padding:6px 8px; border-bottom:1px solid var(--line); text-align:left;}
  th{color:var(--ink-soft); font-weight:700; font-size:11.5px; text-transform:uppercase; letter-spacing:.03em;}
  .pill{display:inline-block; padding:2px 8px; border-radius:99px; font-size:11px; font-weight:700;}
  .pill.yes{background:var(--good-bg); color:var(--good);}
  .pill.no{background:#f0f0ee; color:#93958f;}
  .crown{color:#c99a2e;}

  /* Wizard */
  .steps{display:flex; gap:6px; margin-bottom:16px; flex-wrap:wrap;}
  .step-chip{
    padding:8px 12px; border-radius:8px; border:1px solid var(--line); font-size:12.5px; font-weight:700;
    background:#f5f4f0; color:var(--ink-soft); flex:1; min-width:140px; text-align:center;
  }
  .step-chip.active{background:#fff; border-color:var(--accent); color:var(--accent); box-shadow:0 0 0 1px var(--accent) inset;}
  .step-chip.done{background:var(--good-bg); color:var(--good); border-color:var(--good-bg);}
  .step-chip.locked{opacity:.45;}

  .entry-list{list-style:none; margin:8px 0 0; padding:0; display:flex; flex-direction:column; gap:6px;}
  .entry-list li{display:flex; justify-content:space-between; align-items:center; background:#f6f5f1; padding:6px 10px; border-radius:6px; font-size:12.5px;}
  .entry-list li button{padding:2px 8px; font-size:11px;}

  .avail-day{border:1px solid var(--line); border-radius:8px; padding:10px; min-width:150px;}
  .avail-day .d{font-weight:700; margin-bottom:4px;}
  .status-ok{color:var(--good); font-weight:700;}
  .status-bad{color:var(--danger); font-weight:700;}
  .avail-grid{display:flex; gap:8px; flex-wrap:wrap;}

  /* Main schedule table */
  .table-wrap{overflow:auto; border:1px solid var(--line); border-radius:var(--radius); max-height:75vh; position:relative;}
  table.schedule{white-space:nowrap;}
  table.schedule th, table.schedule td{border:1px solid var(--line); text-align:center; padding:0;}
  table.schedule thead th{
    position:sticky; top:0; background:#fff; z-index:3; padding:6px 4px; font-size:11px;
  }
  table.schedule thead th.wk{color:#b7756f;}
  table.schedule thead th:first-child{left:0; z-index:5; background:#fff;}
  table.schedule tbody th{
    position:sticky; left:0; background:#fff; z-index:2; text-align:left; padding:5px 8px; font-weight:600; font-size:12px; min-width:130px;
  }
  table.schedule td{min-width:34px; height:30px; cursor:pointer; font-weight:700; font-size:11.5px;}
  td.cell-R1{background:var(--r1); color:var(--r1-ink);}
  td.cell-Open{background:var(--open);}
  td.cell-RR{background:var(--rr); color:var(--rr-ink);}
  td.cell-X{background:var(--x); color:var(--x-ink);}
  td.cell-vac{background:var(--vac); color:var(--vac-ink); font-size:10px;}
  td.cell-train{background:var(--train); color:var(--train-ink); font-size:10px;}
  td.cell-od{background:var(--od); color:var(--od-ink); font-size:10px;}
  td.cell-unassigned{color:#c7c9c5;}
  td:hover{outline:2px solid var(--accent); outline-offset:-2px;}
  .acting-star{font-size:9px; vertical-align:super;}

  .legend{display:flex; gap:14px; flex-wrap:wrap; margin-top:10px; font-size:12px; color:var(--ink-soft);}
  .legend span.sw{display:inline-block; width:12px; height:12px; border-radius:3px; margin-right:4px; vertical-align:-2px;}

  .conflict-item{padding:8px 10px; border-radius:7px; margin-bottom:6px; font-size:12.5px; cursor:pointer;}
  .conflict-item.error{background:var(--danger-bg); color:var(--danger);}
  .conflict-item.warn{background:var(--warn-bg); color:var(--warn);}

  .incharge-box{display:flex; gap:12px; flex-wrap:wrap;}
  .incharge-card{border:1px solid var(--line); border-radius:8px; padding:10px 14px; min-width:160px;}
  .incharge-card .area{font-size:11px; color:var(--ink-soft); font-weight:700; text-transform:uppercase;}
  .incharge-card .name{font-size:14px; font-weight:700; margin-top:2px;}

  .modal-backdrop{position:fixed; inset:0; background:rgba(20,20,20,.35); display:flex; align-items:center; justify-content:center; z-index:100;}
  .modal{background:#fff; border-radius:10px; padding:16px; width:320px; max-width:92vw;}
  .modal h3{margin-top:0;}
  .modal .opts{display:flex; flex-wrap:wrap; gap:6px; margin:10px 0;}
  .modal .opts button{min-width:56px;}
  .toast{position:fixed; bottom:18px; left:50%; transform:translateX(-50%); background:var(--ink); color:#fff; padding:9px 16px; border-radius:8px; font-size:13px; z-index:200; opacity:0; transition:opacity .2s;}
  .toast.show{opacity:1;}

  @media print{
    header.app-header, nav.tabs, .no-print{display:none !important;}
    .panel{display:none !important;}
    .panel.print-target{display:block !important;}
    body{background:#fff;}
    .table-wrap{max-height:none; overflow:visible; border:none;}
  }
  @media (max-width:700px){
    table.schedule tbody th{min-width:96px;}
    .header-actions{width:100%; order:3;}
  }
</style>
</head>
<body>

<header class="app-header">
  <h1><span class="dot"></span>OR Morning Assignment</h1>
  <div class="month-picker">
    <label class="muted">เดือน:</label>
    <select id="monthSelect"></select>
  </div>
  <div class="header-actions no-print">
    <button id="btnSaveDraft">บันทึกร่าง</button>
    <button id="btnExport">⬇️ ดาวน์โหลดแบ็คอัพ</button>
    <button id="btnImport">⬆️ นำเข้าแบ็คอัพ</button>
    <input type="file" id="importFile" accept="application/json" style="display:none;">
    <button id="btnResetDemo" class="danger">รีเซ็ตข้อมูลตัวอย่าง</button>
    <button id="btnPrint">พิมพ์ตาราง</button>
  </div>
</header>

<div class="no-print" style="padding:4px 16px; font-size:11.5px; color:var(--ink-soft); background:#fff; border-bottom:1px solid var(--line);" id="storageNote"></div>

<nav class="tabs no-print">
  <button data-tab="dashboard" class="active">ตารางประจำเดือน</button>
  <button data-tab="staff">จัดการเจ้าหน้าที่</button>
  <button data-tab="pairs">ข้อจำกัดคู่</button>
  <button data-tab="wizard">เตรียมข้อมูลรายเดือน</button>
  <button data-tab="conflicts">ข้อขัดแย้ง</button>
  <button data-tab="report">รายงานสรุป</button>
</nav>

<main>

  <!-- DASHBOARD -->
  <section id="panel-dashboard" class="panel active print-target">
    <div class="card">
      <div class="row" style="justify-content:space-between;">
        <h2 id="dashTitle">ตารางมอบหมายประจำเดือน</h2>
        <div class="row no-print">
          <button id="btnAutoAssignTop" class="primary">✨ Auto Assign ทั้งเดือน</button>
          <button id="btnConfirmSchedule">✓ ยืนยันตารางเดือนนี้</button>
        </div>
      </div>
      <div class="incharge-box" id="inchargeBox"></div>
      <div class="table-wrap" style="margin-top:12px;">
        <table class="schedule" id="scheduleTable"></table>
      </div>
      <div class="legend">
        <span><span class="sw" style="background:var(--r1)"></span>R1 (Laparo)</span>
        <span><span class="sw" style="background:var(--open); border:1px solid var(--open-line)"></span>Open (ช่องว่าง)</span>
        <span><span class="sw" style="background:var(--rr)"></span>RR (Recovery)</span>
        <span><span class="sw" style="background:var(--x)"></span>X ขอหยุด</span>
        <span><span class="sw" style="background:var(--vac)"></span>vac ลาพักร้อน</span>
        <span><span class="sw" style="background:var(--train)"></span>อบรม</span>
        <span><span class="sw" style="background:var(--od)"></span>OD</span>
        <span>— ไม่ได้จัด &nbsp; 👑 Incharge ประจำเดือน &nbsp; 👑* Acting Incharge</span>
      </div>
    </div>
  </section>

  <!-- STAFF MANAGEMENT -->
  <section id="panel-staff" class="panel">
    <div class="card">
      <h2>เพิ่ม / แก้ไข เจ้าหน้าที่</h2>
      <form id="staffForm" class="row">
        <input type="hidden" id="staffId">
        <div class="field"><label>ชื่อ</label><input id="staffName" required></div>
        <div class="field"><label>ประเภท</label>
          <select id="staffType"><option value="RN">RN</option><option value="PN">PN</option></select>
        </div>
        <div class="field"><label>วันเริ่มงาน</label><input type="date" id="staffStart" required></div>
        <div class="field"><label>สถานะ</label>
          <select id="staffActive"><option value="1">Active</option><option value="0">Inactive</option></select>
        </div>
        <div class="field"><label>ทำงาน R1</label><select id="compR1"><option value="1">Yes</option><option value="0">No</option></select></div>
        <div class="field"><label>ทำงาน Open</label><select id="compOpen"><option value="1">Yes</option><option value="0">No</option></select></div>
        <div class="field"><label>ทำงาน RR</label><select id="compRR"><option value="0">No</option><option value="1">Yes</option></select></div>
        <div class="field"><label>Incharge R1</label><select id="inchR1"><option value="0">No</option><option value="1">Yes</option></select></div>
        <div class="field"><label>Incharge Open</label><select id="inchOpen"><option value="0">No</option><option value="1">Yes</option></select></div>
        <div class="field"><label>Incharge RR</label><select id="inchRR"><option value="0">No</option><option value="1">Yes</option></select></div>
        <div class="field"><label>&nbsp;</label><button type="submit" class="primary">บันทึกเจ้าหน้าที่</button></div>
        <div class="field" id="cancelEditWrap" style="display:none;"><label>&nbsp;</label><button type="button" id="btnCancelEdit">ยกเลิกแก้ไข</button></div>
      </form>
      <p class="muted">หมายเหตุ: PN ไม่สามารถทำงาน RR และไม่สามารถเป็น Incharge ได้ (ระบบจะบังคับเป็น No อัตโนมัติ)</p>
    </div>
    <div class="card">
      <h2>รายชื่อเจ้าหน้าที่</h2>
      <div style="overflow:auto;">
      <table id="staffTable">
        <thead><tr><th>ชื่อ</th><th>ประเภท</th><th>ประสบการณ์</th><th>R1</th><th>Open</th><th>RR</th><th>Incharge R1</th><th>Incharge Open</th><th>Incharge RR</th><th>สถานะ</th><th></th></tr></thead>
        <tbody></tbody>
      </table>
      </div>
    </div>
    <div class="card">
      <h2>👑 Incharge ประจำเดือน (<span id="inchargeMonthLabel"></span>)</h2>
      <div class="row">
        <div class="field"><label>R1 Incharge</label><select id="inchargeSetR1"></select></div>
        <div class="field"><label>Open Incharge</label><select id="inchargeSetOpen"></select></div>
        <div class="field"><label>RR Incharge</label><select id="inchargeSetRR"></select></div>
        <div class="field"><label>&nbsp;</label><button id="btnSaveIncharge" class="primary">บันทึก Incharge เดือนนี้</button></div>
      </div>
      <p class="muted">Incharge ประจำเดือนควรตั้งค่าไว้ล่วงหน้า ก่อนเริ่มขั้นตอนเตรียมข้อมูลรายเดือน</p>
    </div>
  </section>

  <!-- PAIR RESTRICTIONS -->
  <section id="panel-pairs" class="panel">
    <div class="card">
      <h2>ข้อจำกัดคู่ (Pair Restrictions)</h2>
      <p class="muted">บุคคลสองคนนี้จะไม่ถูกจัดให้อยู่ Area เดียวกันในวันเดียวกัน (Hard Constraint)</p>
      <div class="row">
        <div class="field"><label>คนที่ 1</label><select id="pairA"></select></div>
        <div class="field"><label>คนที่ 2</label><select id="pairB"></select></div>
        <div class="field"><label>&nbsp;</label><button id="btnAddPair" class="primary">เพิ่มข้อจำกัด</button></div>
      </div>
      <ul class="entry-list" id="pairList"></ul>
    </div>
  </section>

  <!-- WIZARD -->
  <section id="panel-wizard" class="panel">
    <div class="steps" id="stepsBar"></div>

    <div class="card" id="stepPanel-1">
      <h2>🌴 Step 1 — Vacation</h2>
      <div class="row">
        <div class="field"><label>เจ้าหน้าที่</label><select id="vacStaff"></select></div>
        <div class="field"><label>ตั้งแต่วันที่</label><input type="date" id="vacFrom"></div>
        <div class="field"><label>ถึงวันที่</label><input type="date" id="vacTo"></div>
        <div class="field"><label>&nbsp;</label><button id="btnAddVac" class="primary">เพิ่ม Vacation</button></div>
      </div>
      <ul class="entry-list" id="vacList"></ul>
      <div class="row" style="margin-top:12px;">
        <button id="btnConfirmVac" class="primary">✓ ยืนยัน Vacation ครบแล้ว</button>
      </div>
    </div>

    <div class="card" id="stepPanel-2">
      <h2>❌ Step 2 — Requested Off (X)</h2>
      <div class="row">
        <div class="field"><label>เจ้าหน้าที่</label><select id="offStaff"></select></div>
        <div class="field"><label>ตั้งแต่วันที่</label><input type="date" id="offFrom"></div>
        <div class="field"><label>ถึงวันที่</label><input type="date" id="offTo"></div>
        <div class="field"><label>&nbsp;</label><button id="btnAddOff" class="primary">เพิ่ม X</button></div>
      </div>
      <ul class="entry-list" id="offList"></ul>
      <div class="row" style="margin-top:12px;">
        <button id="btnConfirmOff" class="primary">✓ ยืนยันวันขอหยุดครบแล้ว</button>
      </div>
    </div>

    <div class="card" id="stepPanel-3">
      <h2>📚 Step 3 — Training</h2>
      <div class="row">
        <div class="field"><label>เจ้าหน้าที่</label><select id="trainStaff"></select></div>
        <div class="field"><label>ตั้งแต่วันที่</label><input type="date" id="trainFrom"></div>
        <div class="field"><label>ถึงวันที่</label><input type="date" id="trainTo"></div>
        <div class="field"><label>&nbsp;</label><button id="btnAddTrain" class="primary">เพิ่ม อบรม</button></div>
      </div>
      <ul class="entry-list" id="trainList"></ul>
      <div class="row" style="margin-top:12px;">
        <button id="btnConfirmTrain" class="primary">✓ ยืนยันข้อมูลอบรมครบแล้ว</button>
      </div>
    </div>

    <div class="card" id="stepPanel-3b">
      <h2>OD — Other Duty <span class="muted">(ไม่บังคับตามลำดับขั้นตอน)</span></h2>
      <div class="row">
        <div class="field"><label>เจ้าหน้าที่</label><select id="odStaff"></select></div>
        <div class="field"><label>ตั้งแต่วันที่</label><input type="date" id="odFrom"></div>
        <div class="field"><label>ถึงวันที่</label><input type="date" id="odTo"></div>
        <div class="field"><label>&nbsp;</label><button id="btnAddOd" class="primary">เพิ่ม OD</button></div>
      </div>
      <ul class="entry-list" id="odList"></ul>
    </div>

    <div class="card" id="stepPanel-4">
      <h2>👥 Step 4 — Available Staff Review</h2>
      <div class="avail-grid" id="availGrid"></div>
    </div>

    <div class="card" id="stepPanel-5">
      <h2>👑 Step 5 — Check Incharge Availability</h2>
      <div id="inchargeCheck"></div>
    </div>

    <div class="card" id="stepPanel-6">
      <h2>✨ Step 6 — Auto Assign ทั้งเดือน</h2>
      <p class="muted">ต้องยืนยัน Vacation, X และ อบรม ให้ครบก่อน จึงจะสามารถ Auto Assign ได้</p>
      <button id="btnAutoAssign" class="primary">✨ Auto Assign ทั้งเดือน</button>
      <div id="autoAssignResult" style="margin-top:10px;"></div>
    </div>
  </section>

  <!-- CONFLICTS -->
  <section id="panel-conflicts" class="panel">
    <div class="card">
      <h2>🚨 Conflict Panel</h2>
      <div id="conflictList"></div>
    </div>
  </section>

  <!-- REPORT -->
  <section id="panel-report" class="panel">
    <div class="card">
      <h2>📊 Balance Report</h2>
      <div style="overflow:auto;">
      <table id="reportTable">
        <thead><tr><th>ชื่อ</th><th>ประเภท</th><th>R1</th><th>Open</th><th>RR</th><th>X</th><th>Vacation</th><th>อบรม</th><th>Acting Incharge</th><th>รวมเวร</th><th>ส่วนต่างจากค่าเฉลี่ย</th></tr></thead>
        <tbody></tbody>
      </table>
      </div>
    </div>
  </section>

</main>

<div id="modalRoot"></div>
<div class="toast" id="toast"></div>

<script>
/* ===================== CONSTANTS ===================== */
const AREAS = ['R1','Open','RR'];
const AREA_LABEL = {R1:'R1 (Laparo)', Open:'Open', RR:'RR (Recovery)'};
const ROOM4 = ['R1','Open'];
const LOCK_TYPES = ['vac','X','อบรม','OD'];
const WEEKDAY_TH = ['อา','จ','อ','พ','พฤ','ศ','ส'];
const STORE_KEYS = { STAFF:'staff-list', PAIRS:'pair-restrictions', MONTHS:'month-index' };

let STATE = { staff: [], pairs: [], months: {} }; // months: { 'YYYY-M': monthDataObject }
let currentMonthKey = null;
