function computeDayAvailability(md, y, m, d){
  const ds = dstr(y,m,d);
  const rn = activeStaff().filter(s=>s.type==='RN');
  const pn = activeStaff().filter(s=>s.type==='PN');
  const lockedRN = rn.filter(s=>getStatus(md,s.id,ds));
  const lockedPN = pn.filter(s=>getStatus(md,s.id,ds));
  return {
    ds,
    totalRN: rn.length, availRN: rn.length-lockedRN.length,
    totalPN: pn.length, availPN: pn.length-lockedPN.length,
    lockedRNCount: lockedRN.length, lockedPNCount: lockedPN.length
  };
}
const MIN_RN = 2+2+3; // R1 2 + Open 2 + RR 3
const MIN_PN = 1+1;   // R1 1 + Open 1

function renderAvailability(){
  const md = ensureMonth(currentMonthKey);
  const {y,m} = parseMonthKey(currentMonthKey);
  const wds = workingDays(y,m);
  const grid = document.getElementById('availGrid');
  grid.innerHTML = wds.map(d=>{
    const a = computeDayAvailability(md,y,m,d);
    const rnOk = a.availRN>=MIN_RN, pnOk = a.availPN>=MIN_PN;
    const ok = rnOk && pnOk;
    let statusHtml;
    if(ok) statusHtml = `<div class="status-ok">🟢 กำลังคนครบ</div>`;
    else {
      const msgs=[];
      if(!rnOk) msgs.push(`RN ขาด ${MIN_RN-a.availRN} คน`);
      if(!pnOk) msgs.push(`PN ขาด ${MIN_PN-a.availPN} คน`);
      statusHtml = `<div class="status-bad">🔴 ${msgs.join(' / ')}</div>`;
    }
    return `<div class="avail-day">
      <div class="d">${d} ${thaiMonthName(m).slice(0,3)}</div>
      <div class="muted">RN: ${a.availRN}/${a.totalRN} ใช้ได้</div>
      <div class="muted">PN: ${a.availPN}/${a.totalPN} ใช้ได้</div>
      ${statusHtml}
    </div>`;
  }).join('');
}

