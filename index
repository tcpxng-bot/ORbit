/* ===================== AUTO ASSIGN ALGORITHM ===================== */
function pairConflictExists(md, ds, area, candidateId, usedToday){
  for(const p of STATE.pairs){
    let other=null;
    if(p.a===candidateId) other=p.b;
    else if(p.b===candidateId) other=p.a;
    if(other && usedToday.has(other)){
      const oa = getAssign(md, other, ds);
      if(oa && oa.area===area) return true;
    }
  }
  return false;
}

function autoAssignMonth(mk){
  const md = ensureMonth(mk);
  const {y,m} = parseMonthKey(mk);
  const wds = workingDays(y,m);
  md.assign = {};
  const conflicts = [];
  const actingCount = {}; STATE.staff.forEach(s=>actingCount[s.id]=0);
  const areaCount = {R1:{}, Open:{}, RR:{}};
  STATE.staff.forEach(s=>{ areaCount.R1[s.id]=0; areaCount.Open[s.id]=0; areaCount.RR[s.id]=0; });

  wds.forEach(d=>{
    const ds = dstr(y,m,d);
    const usedToday = new Set();
    const isLocked = (sid)=> !!getStatus(md, sid, ds);
    const rnAll = activeStaff().filter(s=>s.type==='RN');
    const pnAll = activeStaff().filter(s=>s.type==='PN');

    function assignIncharge(area){
      const fixedId = md.incharge[area];
      const fixed = fixedId ? staffById(fixedId) : null;
      if(fixed && fixed.active && !isLocked(fixed.id)){
        setAssign(md, fixed.id, ds, area, false);
        usedToday.add(fixed.id);
        areaCount[area][fixed.id]++;
        return;
      }
      // Need acting incharge
      let candidates = [];
      let usedRoom4 = false;
      if(ROOM4.includes(area)){
        candidates = rnAll.filter(s=> !isLocked(s.id) && !usedToday.has(s.id)
          && s.comp[area] && s.inch[area]
          && (s.comp.R1 || s.comp.Open) // ห้อง4 member
          && !pairConflictExists(md, ds, area, s.id, usedToday));
        usedRoom4 = true;
      } else {
        candidates = rnAll.filter(s=> !isLocked(s.id) && !usedToday.has(s.id)
          && s.comp.RR && s.inch.RR
          && !pairConflictExists(md, ds, area, s.id, usedToday));
      }
      if(candidates.length===0 && ROOM4.includes(area)){
        // last resort: look at RR-based candidates, but flag for manual decision, do not auto-move
        const rrCandidates = rnAll.filter(s=> !isLocked(s.id) && !usedToday.has(s.id)
          && s.comp[area] && s.inch[area] && s.comp.RR && !(s.comp.R1||s.comp.Open&&false));
        // actually candidates whose primary base is RR: comp.RR true and not counted above (already excluded since above required comp.R1||comp.Open)
        const rrOnly = rnAll.filter(s=> !isLocked(s.id) && !usedToday.has(s.id) && s.inch[area] && s.comp.RR);
        if(rrOnly.length>0){
          conflicts.push({level:'warn', date:ds,
            msg:`${d} — ไม่พบ Acting ${AREA_LABEL[area]} Incharge จากห้อง 4; พบผู้มี competency ใน RR: ${rrOnly.map(c=>c.name).join(', ')} แต่การย้ายอาจทำให้ RR ต่ำกว่ามาตรฐาน ต้องการการตัดสินใจจากผู้จัดตาราง`});
        } else {
          conflicts.push({level:'error', date:ds, msg:`${d} — ไม่พบ Acting ${AREA_LABEL[area]} Incharge ที่มีคุณสมบัติ`});
        }
        return;
      }
      if(candidates.length===0){
        // RR incharge absence - try any RN with RR comp+inch already covered above; if truly none, try pulling from ห้อง4
        if(area==='RR'){
          const room4Pull = rnAll.filter(s=> !isLocked(s.id) && !usedToday.has(s.id) && s.inch.RR
            && !pairConflictExists(md, ds, area, s.id, usedToday));
          if(room4Pull.length>0){
            room4Pull.sort((a,b)=> actingCount[a.id]-actingCount[b.id]);
            const chosen = room4Pull[0];
            setAssign(md, chosen.id, ds, area, true);
            usedToday.add(chosen.id); actingCount[chosen.id]++; areaCount[area][chosen.id]++;
            conflicts.push({level:'warn', date:ds, msg:`${d} — ดึงเจ้าหน้าที่จากห้อง 4 (${chosen.name}) มาเป็น Acting RR Incharge เนื่องจากไม่มีผู้เหมาะสมใน RR`});
            return;
          }
        }
        conflicts.push({level:'error', date:ds, msg:`${d} — ไม่พบ Acting ${AREA_LABEL[area]} Incharge ที่มีคุณสมบัติ`});
        return;
      }
      candidates.sort((a,b)=> (actingCount[a.id]-actingCount[b.id]) || ((areaCount.R1[a.id]+areaCount.Open[a.id]+areaCount.RR[a.id])-(areaCount.R1[b.id]+areaCount.Open[b.id]+areaCount.RR[b.id])));
      const chosen = candidates[0];
      setAssign(md, chosen.id, ds, area, true);
      usedToday.add(chosen.id);
      actingCount[chosen.id]++;
      areaCount[area][chosen.id]++;
    }

    AREAS.forEach(assignIncharge);

    function fillArea(area, needRN, needPN, targetRN){
      let haveRN = STATE.staff.filter(s=>{const a=getAssign(md,s.id,ds); return a&&a.area===area&&s.type==='RN';}).length;
      let havePN = STATE.staff.filter(s=>{const a=getAssign(md,s.id,ds); return a&&a.area===area&&s.type==='PN';}).length;
      let rnPool = rnAll.filter(s=> !isLocked(s.id) && !usedToday.has(s.id) && s.comp[area]);
      rnPool.sort((a,b)=> areaCount[area][a.id]-areaCount[area][b.id]);
      while(haveRN<needRN && rnPool.length){
        const idx = rnPool.findIndex(s=> !pairConflictExists(md, ds, area, s.id, usedToday));
        if(idx<0) break;
        const cand = rnPool[idx];
        setAssign(md, cand.id, ds, area, false);
        usedToday.add(cand.id); areaCount[area][cand.id]++; haveRN++;
        rnPool.splice(idx,1);
      }
      if(area!=='RR'){
        let pnPool = pnAll.filter(s=> !isLocked(s.id) && !usedToday.has(s.id) && s.comp[area]);
        pnPool.sort((a,b)=> areaCount[area][a.id]-areaCount[area][b.id]);
        while(havePN<needPN && pnPool.length){
          const idx = pnPool.findIndex(s=> !pairConflictExists(md, ds, area, s.id, usedToday));
          if(idx<0) break;
          const cand = pnPool[idx];
          setAssign(md, cand.id, ds, area, false);
          usedToday.add(cand.id); areaCount[area][cand.id]++; havePN++;
          pnPool.splice(idx,1);
        }
      }
      if(haveRN<needRN) conflicts.push({level:'error', date:ds, msg:`${d} — RN ${AREA_LABEL[area]} เหลือ ${haveRN} / ต้องการขั้นต่ำ ${needRN}`});
      if(area!=='RR' && havePN<needPN) conflicts.push({level:'error', date:ds, msg:`${d} — PN ${AREA_LABEL[area]} เหลือ ${havePN} / ต้องการขั้นต่ำ ${needPN}`});
      // soft: top up RN toward targetRN
      if(targetRN){
        let rnPool2 = rnAll.filter(s=> !isLocked(s.id) && !usedToday.has(s.id) && s.comp[area]);
        rnPool2.sort((a,b)=> areaCount[area][a.id]-areaCount[area][b.id]);
        while(haveRN<targetRN && rnPool2.length){
          const idx = rnPool2.findIndex(s=> !pairConflictExists(md, ds, area, s.id, usedToday));
          if(idx<0) break;
          const cand = rnPool2[idx];
          setAssign(md, cand.id, ds, area, false);
          usedToday.add(cand.id); areaCount[area][cand.id]++; haveRN++;
          rnPool2.splice(idx,1);
        }
      }
    }
    fillArea('R1',2,1,3);
    fillArea('Open',2,1,3);
    fillArea('RR',3,0,null);

    // check pair restriction hard failure detection (if two paired both ended up same area - shouldn't happen given checks)
  });

  md.actingLog = actingCount;
  md.conflicts = conflicts;
  md.autoAssignedAt = new Date().toISOString();
  return conflicts;
}

